---
import CommentSection from "@components/organisms/comment/CommentSection.astro";
import { siteConfig } from "@/config/siteConfig";
import ArchivePanel from "@components/organisms/ArchivePanel.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";

const sortedPostsList = await getSortedPostsList();
const archiveSummary = `${sortedPostsList.length} ${i18n(I18nKey.postsCount)}`;
---

<MainGridLayout title={i18n(I18nKey.archive)} description={archiveSummary} page="archive">
    <ArchivePanel sortedPosts={sortedPostsList} client:visible></ArchivePanel>
<div id="legacy-discussion"><CommentSection context={{ key: "archive", path: "/archive/", title: i18n(I18nKey.archive), language: siteConfig.lang }} /></div>
</MainGridLayout>

